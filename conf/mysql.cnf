# Generated MySQL Configuration (based on 22.0 GiB memory, deployment type: physical):
# Configuration generated on: 2026/06/09 - 14:36:07
[mysqld]
#mysql_native_password=ON
init_connect='SET collation_connection = utf8mb4_0900_ai_ci; SET NAMES utf8mb4'
sql_mode='STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION'
character-set-server=utf8mb4
#character-set-client-handshake=FALSE
collation-server=utf8mb4_0900_ai_ci
datadir=/var/lib/mysql

#--------- InnoDB Configuration ---------
innodb_buffer_pool_size=16G
innodb_log_buffer_size=64M
innodb_write_io_threads=8
innodb_flush_log_at_trx_commit=1
innodb_buffer_pool_instances=16
innodb_redo_log_capacity=4G
innodb_flush_method=O_DIRECT

#--------- Table Cache Configuration ---------
table_open_cache=1370
table_definition_cache=1086

#--------- Connection Configuration ---------
max_connections=2252
wait_timeout=600
interactive_timeout=600
thread_cache_size=32

#--------- Temporary Tables Configuration ---------
tmp_table_size=256M
max_heap_table_size=256M

#--------- Other Configuration ---------
max_allowed_packet=1073741824
performance_schema=ON
skip_name_resolve
#skip_host_cache

#--------- Logging Configuration ---------
# -- Disabled by Default -- #
# log_error=/var/log/mysql/mysql_error.log
# general_log_file=/var/log/mysql/mysql.log
# general_log=0
slow_query_log=1
slow_query_log_file=/var/log/mysql/mysql_slow.log
long_query_time=120
log_queries_not_using_indexes=1

#--------- mysql client default settings ------------
[mysql]
default-character-set=utf8

#--------- embedded settings ------------------
[embedded]
datadir=/var/lib/mysql

